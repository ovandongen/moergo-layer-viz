<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>MoergoLayerViz.App</RootNamespace>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <Version>0.0.0-dev</Version>
    <AssemblyTitle>Moergo Layer Viz</AssemblyTitle>
    <Product>Moergo Layer Viz</Product>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.13" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="11.3.13" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.13" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.13" />
    <!-- Pinned to override Avalonia.FreeDesktop's transitive 0.21.2 (CVE GHSA-xrw6-gwf8-vvr9). -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
    <PackageReference Include="Projektanker.Icons.Avalonia" Version="9.6.2" />
    <PackageReference Include="Projektanker.Icons.Avalonia.FontAwesome" Version="9.6.2" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="2.88.9" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\icon.png" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\Strings.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Strings.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <Compile Update="Resources\Strings.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>Strings.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MoergoLayerViz.Core\MoergoLayerViz.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MoergoLayerViz.Tests" />
  </ItemGroup>

  <!--
    Vendor the native hidapi binaries next to the executable per RID.
    HidApi.Net is just bindings; it needs the host to provide libhidapi.
    Copying to output root (not runtimes/<rid>/native/) is intentional —
    the .NET native-library loader searches the exe's directory, which
    works for both `dotnet run` and self-contained publish. The Condition
    handles `dotnet run` (no explicit RID) by inferring from the host OS
    so dev builds pick up the dylib without -r osx-arm64.
  -->
  <PropertyGroup>
    <_HidapiHostRid Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</_HidapiHostRid>
    <_HidapiHostRid Condition="'$(_HidapiHostRid)' == '' AND $([MSBuild]::IsOSPlatform('OSX')) AND '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'Arm64'">osx-arm64</_HidapiHostRid>
    <_HidapiHostRid Condition="'$(_HidapiHostRid)' == '' AND $([MSBuild]::IsOSPlatform('OSX')) AND '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'X64'">osx-x64</_HidapiHostRid>
    <_HidapiHostRid Condition="'$(_HidapiHostRid)' == '' AND $([MSBuild]::IsOSPlatform('Windows'))">win-x64</_HidapiHostRid>
    <_HidapiHostRid Condition="'$(_HidapiHostRid)' == '' AND $([MSBuild]::IsOSPlatform('Linux'))">linux-x64</_HidapiHostRid>
    <_HidapiRoot>$(MSBuildThisFileDirectory)..\..\external\hidapi-binaries\runtimes\</_HidapiRoot>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(_HidapiRoot)osx-arm64\native\libhidapi.dylib" Condition="'$(_HidapiHostRid)' == 'osx-arm64' AND Exists('$(_HidapiRoot)osx-arm64\native\libhidapi.dylib')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>libhidapi.dylib</Link>
      <Visible>false</Visible>
    </None>
    <None Include="$(_HidapiRoot)osx-x64\native\libhidapi.dylib" Condition="'$(_HidapiHostRid)' == 'osx-x64' AND Exists('$(_HidapiRoot)osx-x64\native\libhidapi.dylib')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>libhidapi.dylib</Link>
      <Visible>false</Visible>
    </None>
    <None Include="$(_HidapiRoot)win-x64\native\hidapi.dll" Condition="'$(_HidapiHostRid)' == 'win-x64' AND Exists('$(_HidapiRoot)win-x64\native\hidapi.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>hidapi.dll</Link>
      <Visible>false</Visible>
    </None>
    <None Include="$(_HidapiRoot)linux-x64\native\libhidapi.so" Condition="'$(_HidapiHostRid)' == 'linux-x64' AND Exists('$(_HidapiRoot)linux-x64\native\libhidapi.so')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>libhidapi.so</Link>
      <Visible>false</Visible>
    </None>
  </ItemGroup>

</Project>
